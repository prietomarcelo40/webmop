# --------------------------------------------
# Flask core
# --------------------------------------------
# CLAVE SECRETA: Genera una nueva con: python -c "import secrets; print(secrets.token_hex(24))"
# ¡OBLIGATORIO CAMBIAR ESTE VALOR EN PRODUCCIÓN!
SECRET_KEY=cambia_esta_clave_por_una_generada_aleatoriamente

# Entorno: 'development' o 'production'
FLASK_ENV=development

# Debug: 1 para activar (solo en desarrollo), 0 para desactivar (producción)
FLASK_DEBUG=0

# --------------------------------------------
# WhatsApp
# --------------------------------------------
# Número de teléfono con código de país (sin el +, sin espacios)
WHATSAPP_NUMBER=5491133810134

# Mensaje predefinido (codificado para URL)
WHATSAPP_MESSAGE=Hola!%20Vi%20tu%20página%20y%20quiero%20más%20información.

# --------------------------------------------
# Email (Gmail SMTP)
# --------------------------------------------
EMAIL_REMITENTE=tu_correo@gmail.com
EMAIL_PASSWORD=abcd efgh ijkl mnop
EMAIL_DESTINATARIO=tu_correo_destino@gmail.com

# --------------------------------------------
# Google Analytics (opcional)
# --------------------------------------------
GA_TRACKING_ID=G-XXXXXXXXXX

# --------------------------------------------
# Rate Limiting (opcional)
# --------------------------------------------
RATELIMIT_STORAGE_URI=memory://

# --------------------------------------------
# Render (producción)
# --------------------------------------------
# Render asigna automáticamente el puerto, no es necesario definirlo aquí.
# Esta variable se usa para detectar el entorno de producción.
RENDER_EXTERNAL_URL=https://webmop.onrender.com.ar